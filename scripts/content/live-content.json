  "contact.html": "\n<div class=\"section-container no-padding\">\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-xs-12\">\n<div id=\"map\"></div>\n</div>\n<div class=\"col-xs-12\">\n<div class=\"row\">\n<div class=\"col-md-6\">\n<form action=\"\" class=\"reveal-content contact-form\">\n<div class=\"form-group\">\n<input class=\"form-control\" id=\"name\" placeholder=\"Full name\" type=\"name\"/>\n</div>\n<div class=\"form-group\">\n<input class=\"form-control\" id=\"email\" placeholder=\"Email\" type=\"email\"/>\n</div>\n<div class=\"form-group\">\n<input class=\"form-control\" id=\"subject\" placeholder=\"Subject\" type=\"text\"/>\n</div>\n<div class=\"form-group\">\n<textarea class=\"form-control\" placeholder=\"Enter your message\" rows=\"3\"></textarea>\n</div>\n<button class=\"btn btn-primary btn-lg\" type=\"submit\">Send</button>\n</form>\n</div>\n<div class=\"col-md-5 col-md-offset-1\">\n<h3>Head Office</h3>\n<div>\n<p>42 rue Rouelle <br/>75015 Paris FRANCE</p>\n</div>\n<div>\n<p>contact@mybusiness.com<br/>+331 45 31 64 32</p>\n</div>\n<div>\n<h3>Employment</h3>\n</div>\n<div>\n<p>To apply for a job with our team, please feel free to send us your Linkedin profile link\n                                ou CV to : employment@mybusiness.com</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n",
